{
  "schema_version": 2,
  "purpose": "Active runtime secret names and authority only. Never secret values.",
  "policy": {
    "owner_funded_spend_usd": 0,
    "secret_values_in_git": false,
    "secret_values_in_prompts_logs_evidence": false,
    "wallet_private_key_main_worker_custody": false,
    "fail_closed_on_unknown_cost": true
  },
  "variables": [
    {
      "name": "AGENTHANSA_API_KEY",
      "kind": "money_rail_api_key",
      "required": "conditional",
      "state": "REQUIRED_ONLY_WHEN_AGENTHANSA_EXECUTION_IS_ENABLED",
      "authority": "AGENTHANSA_ADAPTER_ONLY",
      "masked": true,
      "hidden": true
    },
    {
      "name": "RUN_NOW_TEST_TOKEN",
      "kind": "owner_control_token",
      "required": "conditional",
      "state": "OWNER_AUTHORIZED_RUN_NOW_ONLY",
      "authority": "OWNER_CONTROL_ROUTE_ONLY",
      "masked": true,
      "hidden": true
    },
    {
      "name": "TASKMARKET_DEVICE_API_TOKEN",
      "kind": "signer_api_token",
      "required": "taskmarket_signer",
      "state": "PRIVATE_SIGNER_BINDING_ONLY",
      "authority": "TASKMARKET_SIGNER_ONLY",
      "masked": true,
      "hidden": true
    },
    {
      "name": "TASKMARKET_ENCRYPTED_KEY",
      "kind": "encrypted_signing_material",
      "required": "taskmarket_signer",
      "state": "PRIVATE_SIGNER_BINDING_ONLY",
      "authority": "TASKMARKET_SIGNER_ONLY",
      "masked": true,
      "hidden": true
    }
  ],
  "forbidden_runtime_material": [
    "METAMASK_SEED_PHRASE",
    "METAMASK_PRIVATE_KEY",
    "RAW_WALLET_PRIVATE_KEY",
    "BINANCE_WITHDRAWAL_SECRET",
    "TASKMARKET_KEYSTORE_B64"
  ]
}
